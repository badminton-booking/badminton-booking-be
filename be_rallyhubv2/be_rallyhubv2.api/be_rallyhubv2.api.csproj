<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>be_rallyhubv2</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.22" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\be_rallyhubv2.infrastructure\be_rallyhubv2.infrastructure.csproj" />
      <ProjectReference Include="..\be_rallyhubv2.persistence\be_rallyhubv2.persistence.csproj" />
      <ProjectReference Include="..\be_rallyhubv2.presentation\be_rallyhubv2.presentation.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="dependencyInjection\extensions\" />
      <Folder Include="dependencyInjection\openapi\" />
      <Folder Include="dependencyInjection\options\" />
      <Folder Include="docs\db_configuration_code\" />
      <Folder Include="docs\found_src_code\" />
      <Folder Include="middlewares\" />
      <Folder Include="security\" />
      <Folder Include="startup\" />
    </ItemGroup>

</Project>
